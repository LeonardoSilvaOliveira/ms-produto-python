# ===========================================
# MS Produtos - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e ajuste os valores
# ===========================================

# Ambiente
ENVIRONMENT=development
DEBUG=true

# Aplicação
APP_NAME=MS Produtos
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Banco de Dados
# SQLite (desenvolvimento)
DATABASE_URL=sqlite:///./produtos.db

# Oracle (produção) - Descomente e configure para usar Oracle
# DATABASE_URL=oracle+oracledb://usuario:senha@host:1521/?service_name=XEPDB1
# Exemplo com Oracle Thick mode (requer Oracle Client instalado):
# DATABASE_URL=oracle+oracledb://usuario:senha@host:1521/?service_name=XEPDB1&thick_mode=true

# Segurança (JWT) - IMPORTANTE: Altere em produção!
SECRET_KEY=sua-chave-secreta-super-segura-aqui-mude-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Origens permitidas para o frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Logs
LOG_LEVEL=INFO
LOG_FORMAT=text